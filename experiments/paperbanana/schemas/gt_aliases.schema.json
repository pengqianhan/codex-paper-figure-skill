{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewedGroundTruthAliases",
  "type": "object",
  "additionalProperties": false,
  "required": ["aliases"],
  "properties": {
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["declared", "resolved", "sha256"],
        "properties": {
          "declared": {"type": "string", "pattern": "^images/"},
          "resolved": {"type": "string", "pattern": "^images/"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
