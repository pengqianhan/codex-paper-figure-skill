{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillOptLiteProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["round", "job_id", "base_skill_sha256", "sampling_report", "diagnosis", "edits", "expected_impact", "regressions_to_watch"],
  "properties": {
    "round": {"type": "integer", "minimum": 1, "maximum": 3},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "base_skill_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sampling_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_read", "failed_total", "passed_read", "passed_total"],
      "properties": {
        "failed_read": {"type": "integer", "minimum": 0, "maximum": 12},
        "failed_total": {"type": "integer", "minimum": 0, "maximum": 12},
        "passed_read": {"type": "integer", "minimum": 0, "maximum": 12},
        "passed_total": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "diagnosis": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "support_case_ids"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "support_case_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "pattern": "^case_[0-9a-f]{16}$"}
          }
        }
      }
    },
    "edits": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "target", "content", "support_case_ids"],
        "properties": {
          "op": {"enum": ["append", "insert_after", "replace", "delete"]},
          "target": {"type": "string"},
          "content": {"type": "string"},
          "support_case_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "pattern": "^case_[0-9a-f]{16}$"}
          }
        }
      }
    },
    "expected_impact": {"type": "string", "minLength": 1},
    "regressions_to_watch": {"type": "array", "items": {"type": "string"}}
  }
}
