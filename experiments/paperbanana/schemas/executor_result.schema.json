{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "job_id", "skill_sha256", "executor_manifest_sha256", "status", "artifacts", "artifact_sha256", "budget", "errors"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{16}$"},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "skill_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executor_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "infrastructure_failed", "invalid_output"]},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drawio", "png", "reference", "trace"],
      "properties": {
        "drawio": {"type": ["string", "null"]},
        "png": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "trace": {"type": "string"}
      }
    },
    "artifact_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drawio", "png", "reference", "trace"],
      "properties": {
        "drawio": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "png": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reference": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "trace": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_gen_calls", "correction_cycles", "retries", "wall_seconds"],
      "properties": {
        "image_gen_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "correction_cycles": {"type": "integer", "minimum": 0, "maximum": 2},
        "retries": {"type": "integer", "minimum": 0, "maximum": 1},
        "wall_seconds": {"type": "number", "minimum": 0, "maximum": 1200}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
